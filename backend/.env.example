# Groq API Key (100% FREE!)
# Get your FREE API key from: https://console.groq.com/keys
# No credit card required, free forever
GROQ_API_KEY=your_groq_api_key_here

# Pexels API Key (FREE!)
# Get your FREE API key from: https://www.pexels.com/api/
# 200 requests per hour, completely free
PEXELS_API_KEY=your_pexels_api_key_here

# Redis URL (for Celery broker and backend)
# For local development (requires Redis installed):
# REDIS_URL=redis://localhost:6379/0
# For production, use free Redis from Upstash, Railway, or Redis Cloud
REDIS_URL=redis://localhost:6379/0
