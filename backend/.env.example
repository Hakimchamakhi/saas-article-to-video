# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Pexels API Key
# Get your API key from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Redis URL (for Celery broker and backend)
# Default for local development:
REDIS_URL=redis://localhost:6379/0

# Frontend URL for CORS (production)
# For local development, defaults to http://localhost:3000
# For production, set to your Vercel URL
# FRONTEND_URL=https://your-app.vercel.app
# For multiple URLs (staging + production), use comma-separated list:
# FRONTEND_URL=https://your-app.vercel.app,https://staging-app.vercel.app
